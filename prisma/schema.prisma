// Prisma Schema for E-Commerce Modular Platform
// Configured for PostgreSQL with Docker support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum AssetType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String
  role         Role      @default(ADMIN)
  avatar       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assets       Asset[]
  products     Product[]

  @@map("users")
}

model Asset {
  id           String        @id @default(cuid())
  name         String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  fileType     AssetType     @default(IMAGE)
  width        Int?
  height       Int?
  duration     Float?        // Video duration in seconds
  altText      String?
  caption      String?
  folder       String?       @default("default")
  tags         String[]      @default([])
  uploaderId   String?
  uploader     User?         @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  productAssets ProductAsset[]

  @@index([fileType])
  @@index([createdAt])
  @@map("assets")
}

model Category {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  parentId     String?
  parent       Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]        @relation("CategoryHierarchy")
  level        Int               @default(0) // 0: Root category, 1: Subcategory, 2: Sub-subcategory
  isActive     Boolean           @default(true)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  productCategories ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id           String         @id @default(cuid())
  sku          String         @unique
  upc          String?        // Universal Product Code (UPC)
  name         String
  slug         String         @unique
  description  String?
  price        Float          @default(0)
  comparePrice Float?
  costPrice    Float?
  currentStock Int            @default(0)
  minStock     Int            @default(0)
  warehouse    String?        @default("gyanwarehouse")
  status       ProductStatus  @default(ACTIVE)
  isSoldOut    Boolean        @default(false)
  brand        String?

  // Google Merchant Center Integration
  googleMerchantSync  Boolean   @default(false)
  googleCategory      String?   // e.g. Apparel & Accessories > Clothing
  googleCondition     String?   @default("new") // new, refurbished, used
  googleBrand         String?
  googleGtin          String?   // Global Trade Item Number (UPC/EAN/ISBN)
  googleMpn           String?   // Manufacturer Part Number
  googleSyncStatus    String?   @default("READY") // READY, SYNCED, FAILED
  googleLastSyncedAt  DateTime?

  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assets       ProductAsset[]
  categories   ProductCategory[]

  @@map("products")
}

model ProductCategory {
  id           String     @id @default(cuid())
  productId    String
  categoryId   String
  isMain       Boolean    @default(false)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model ProductAsset {
  id           String     @id @default(cuid())
  productId    String
  assetId      String
  isPrimary    Boolean    @default(false)
  displayOrder Int        @default(0)

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([productId, assetId])
  @@map("product_assets")
}
